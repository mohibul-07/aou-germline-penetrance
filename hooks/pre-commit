#!/usr/bin/env bash
# Block anything that could be All of Us participant data or licensed reference data.
# Install: ln -s ../../hooks/pre-commit .git/hooks/pre-commit
set -euo pipefail
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)

# 1. Forbidden file types / names
bad=$(echo "$staged" | grep -E '\.(vcf|vcf\.gz|vcf\.bgz|bcf|tbi|tsv|csv|pkl|parquet|xlsx|osa2?|osi|oga|fa|fai|gff3)$|genemap2\.txt|revel_with_transcript_ids|ancestry_preds' \
      | grep -v '^tests/synthetic/' || true)
if [[ -n "$bad" ]]; then echo "BLOCKED data-like files:"; echo "$bad"; fail=1; fi

# 2. Notebooks must have outputs cleared
for nb in $(echo "$staged" | grep '\.ipynb$' || true); do
  if python3 -c "import json,sys; nb=json.load(open('$nb')); sys.exit(any(c.get('outputs') for c in nb['cells'] if c['cell_type']=='code'))"; then :; else
    echo "BLOCKED: $nb has cell outputs. Clear All Outputs first."; fail=1; fi
done

# 3. Text that looks like participant identifiers (7-digit research IDs in bulk) or person-level tables
for f in $(echo "$staged" | grep -E '\.(py|sh|md|txt|ipynb)$' || true); do
  if grep -qE '(person_id|research_id)[,\t ]+[0-9]{7}' "$f" || [[ $(grep -oE '\b[0-9]{7}\b' "$f" | sort -u | wc -l) -gt 20 ]]; then
    echo "BLOCKED: $f may contain participant IDs"; fail=1; fi
done

[[ $fail -eq 0 ]] || { echo "Commit aborted. All of Us data must stay in the Workbench."; exit 1; }

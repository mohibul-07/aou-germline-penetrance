# Source this file before running any script:  source config/params.env
# Edit paths to match your Workbench workspace.

# All of Us v9 Controlled Tier CDR (WORKSPACE_CDR is NOT auto-injected on Dataproc)
export WORKSPACE_CDR="wb-silky-artichoke-2408.C2025Q4R6"
export GOOGLE_PROJECT="${GOOGLE_PROJECT:-}"   # requester-pays project for gsutil -u; Workbench sets this for you

# Workspace layout
export WS="/home/dataproc/workspace/notebooks"
export COHORT_DIR="$WS/01_cohort"
export RESULTS_DIR="$WS/02_results"
export FV="$WS/fastVEP"                 # fastVEP working dir (binary, data/, sa_databases/, sa_sources/)
export FVEP_BIN="$FV/fastvep"
export FVEP_REPO="/home/dataproc/fastVEP_repo"   # clone of Huang-lab/fastVEP for helper scripts

# GCS backup (Dataproc local disk is wiped on every cluster restart)
# Set to your own workspace bucket before sourcing (it is not stored in this repo), e.g.
#   export BACKUP_BUCKET="gs://<your-workspace-staging-bucket>/notebooks"
# Scripts that read or write the backup stop with a message if it is unset.
export BACKUP_BUCKET="${BACKUP_BUCKET:-}"

# Controlled-tier mount (path may differ between clusters; check `ls /home/dataproc/workspace/`)
export CT_ROOT="${CT_ROOT:-$WS/vwb-aou-datasets-controlled/v9/wgs/short_read/snpindel}" # verify local mount separately
export VAT="$CT_ROOT/vat/vat_complete.bgz.tsv.gz"     # v9 name (v8 was variant_annotation_table.bgz.tsv.gz)
export ANCESTRY="$COHORT_DIR/ancestry_preds.tsv"      # v9 name (v8 was echo_v4_r2.ancestry_preds.tsv)

# Panel
export REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export TARGETS_BED="$REPO_ROOT/config/targets.bed"
export PANEL_GENES="$REPO_ROOT/config/panel_genes.txt"
export PANEL_CHROMS="1 2 3 5 7 9 10 11 13 14 16 17 18 19 22"

# Export-only reconstruction: all data paths are outside the repository.
export PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export ARTIFACT_DIR="$COHORT_DIR/phetk_wgs_v9_X1_0"
export SEER_DIR="$COHORT_DIR/seer_validation_v9"
export EXPORT_WORK_DIR="$RESULTS_DIR/code_export_reconstruction"
